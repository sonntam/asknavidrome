#: skill/app.py:227
msgid "Ready!"
msgstr "Bereit!"

#: skill/app.py:251
msgid "This device is not supported"
msgstr "Dieses Gerät wird nicht unterstützt"

#: skill/app.py:284
msgid ""
"AskNavidrome lets you interact with media servers that offer a Subsonic "
"compatible A.P.I."
msgstr ""
"AskNavidrome ermöglicht die Interaktion mit Medienservern, die eine "
"Subsonic-kompatible A.P.I. bieten."

#: skill/app.py:316 skill/app.py:376 skill/app.py:466
msgid "I couldn't find the artist {artist} in the collection."
msgstr "Ich konnte den Künstler {artist} nicht in der Sammlung finden."

#: skill/app.py:333
msgid "Playing music by: {artist}"
msgstr "Spiele Musik von: {artist}"

#: skill/app.py:389
msgid "I couldn't find an album called {album} by {artist} in the collection."
msgstr "Ich konnte kein Album namens {album} von {artist} in der Sammlung finden."

#: skill/app.py:403
msgid "Playing {album} by: {artist}"
msgstr "Spiele {album} von: {artist}"

#: skill/app.py:419
msgid "I couldn't find the album {album} in the collection."
msgstr "Ich konnte das Album {album} nicht in der Sammlung finden."

#: skill/app.py:433
msgid "Playing {album}"
msgstr "Spiele {album}"

#: skill/app.py:481
msgid "I couldn't find a song called {song} by {artist} in the collection."
msgstr "Ich konnte keinen Song namens {song} von {artist} in der Sammlung finden."

#: skill/app.py:489
msgid "Playing {song} by {artist}"
msgstr "Spiele {song} von {artist}"

